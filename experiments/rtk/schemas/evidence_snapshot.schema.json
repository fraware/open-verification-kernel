{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/rtk/evidence_snapshot.schema.json",
  "title": "RTK evidence snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshot_id",
    "registry",
    "revision",
    "digest",
    "digest_algorithm",
    "completeness_policy",
    "artifacts"
  ],
  "properties": {
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "registry": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "digest_algorithm": {
      "const": "sha256"
    },
    "completeness_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "required_artifact_classes",
        "complete"
      ],
      "properties": {
        "policy_id": {
          "type": "string",
          "minLength": 1
        },
        "required_artifact_classes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "complete": {
          "type": "boolean"
        },
        "missing_required_artifacts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
