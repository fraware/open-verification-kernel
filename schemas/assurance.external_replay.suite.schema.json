{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openverification.dev/schemas/assurance.external_replay.suite.schema.json",
  "title": "OVK External Assurance Replay Suite",
  "type": "object",
  "required": ["schema_version", "suite_id", "cases"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "ovk.assurance_external_replay_suite.v1"},
    "suite_id": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "case_id",
          "repository",
          "repository_url",
          "validation_class",
          "base_sha",
          "head_sha",
          "safety_label",
          "expected_head_assurance",
          "guarantee_manifest",
          "protected_effect_profile",
          "provenance"
        ],
        "additionalProperties": false,
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "repository": {"type": "string", "minLength": 1},
          "repository_url": {"type": "string", "minLength": 1},
          "validation_class": {
            "enum": ["public_upstream_reduction", "independent_external"]
          },
          "base_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
          "head_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
          "description": {"type": "string"},
          "safety_label": {"enum": ["safe", "unsafe"]},
          "expected_head_assurance": {
            "enum": ["established", "not_established", "any"]
          },
          "guarantee_manifest": {"type": "object"},
          "protected_effect_profile": {"type": "object"},
          "provenance": {
            "type": "object",
            "required": ["contamination_status", "adjudication_kind", "references"],
            "additionalProperties": true,
            "properties": {
              "contamination_status": {
                "enum": ["public_development_case", "held_out_independent"]
              },
              "adjudication_kind": {
                "enum": [
                  "public_security_advisory",
                  "public_merged_fix",
                  "public_issue",
                  "qualification_human_review"
                ]
              },
              "references": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 1}
              }
            }
          },
          "qualification_human_adjudicated": {"type": "boolean"},
          "human_review_minutes": {
            "type": ["number", "null"],
            "minimum": 0
          }
        }
      }
    }
  }
}