{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openverification.dev/schemas/verification.bundle.v3.schema.json",
  "title": "Verification Evidence Bundle v3",
  "type": "object",
  "required": ["bundle_id", "schema_version", "subject", "evidence", "decision", "open_obligations"],
  "properties": {
    "bundle_id": {"type": "string", "pattern": "^bundle-[0-9a-f]{16}$"},
    "schema_version": {"const": "ovk.bundle.v3"},
    "subject": {
      "type": "object",
      "required": ["repo", "head_sha"],
      "properties": {
        "repo": {"type": "string", "minLength": 1},
        "head_sha": {"type": "string", "minLength": 1},
        "base_sha": {"type": ["string", "null"]},
        "pull_request": {"type": ["integer", "string", "null"]}
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "verification.evidence.v3.schema.json"}
    },
    "decision": {
      "type": "object",
      "required": [
        "decision_state",
        "original_decision_state",
        "merge_recommendation",
        "reason",
        "controlling_finding_ids",
        "finding_contributions",
        "human_review_required"
      ],
      "properties": {
        "decision_state": {
          "type": "string",
          "enum": ["allow", "block", "needs_review", "unknown", "error", "skipped"]
        },
        "original_decision_state": {
          "type": "string",
          "enum": ["allow", "block", "needs_review", "unknown", "error", "skipped"]
        },
        "merge_recommendation": {
          "type": "string",
          "enum": ["allow", "block", "require_human_review", "require_stronger_check"]
        },
        "reason": {"type": "string", "minLength": 1},
        "controlling_finding_ids": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "finding_contributions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["finding_id", "claim_status", "required", "contribution"],
            "properties": {
              "finding_id": {"type": "string", "minLength": 1},
              "claim_status": {
                "type": "string",
                "enum": ["pass", "fail", "unknown", "error", "skipped"]
              },
              "required": {"type": "boolean"},
              "contribution": {
                "type": "string",
                "enum": ["controlling", "supporting", "non_controlling", "warning"]
              },
              "detail": {"type": ["string", "null"]}
            },
            "additionalProperties": false
          }
        },
        "human_review_required": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "open_obligations": {
      "type": "array",
      "items": {"type": "object"}
    }
  },
  "additionalProperties": false
}
