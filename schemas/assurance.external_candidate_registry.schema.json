{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openverification.dev/schemas/assurance.external_candidate_registry.schema.json",
  "title": "OVK External Assurance Candidate Registry",
  "type": "object",
  "required": ["schema_version", "registry_id", "reviewed_against", "candidates"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "ovk.assurance_external_candidate_registry.v1"},
    "registry_id": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "reviewed_against": {
      "type": "object",
      "required": ["protected_effect_profile_type", "guarantee_type"],
      "additionalProperties": false,
      "properties": {
        "protected_effect_profile_type": {"type": "string", "minLength": 1},
        "guarantee_type": {"type": "string", "minLength": 1},
        "ovk_revision": {"type": ["string", "null"]}
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "candidate_id",
          "repository",
          "framework",
          "security_property",
          "triage_status",
          "semantic_pattern",
          "reason_codes",
          "references",
          "qualification_eligible"
        ],
        "additionalProperties": false,
        "properties": {
          "candidate_id": {"type": "string", "minLength": 1},
          "repository": {"type": "string", "minLength": 1},
          "framework": {"type": "string", "minLength": 1},
          "security_property": {"type": "string", "minLength": 1},
          "triage_status": {
            "enum": [
              "supported_now",
              "unsupported_semantics",
              "requires_new_guarantee_family",
              "insufficient_public_evidence"
            ]
          },
          "semantic_pattern": {"type": "string", "minLength": 1},
          "reason_codes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "repository_url": {"type": ["string", "null"]},
          "base_sha": {
            "type": ["string", "null"],
            "pattern": "^[0-9a-fA-F]{40}$"
          },
          "head_sha": {
            "type": ["string", "null"],
            "pattern": "^[0-9a-fA-F]{40}$"
          },
          "fix_pr": {"type": ["string", "null"]},
          "references": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "notes": {"type": "string"},
          "qualification_eligible": {"type": "boolean"}
        }
      }
    }
  }
}