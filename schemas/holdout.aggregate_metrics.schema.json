{
  "$defs": {
    "lane_metrics": {
      "additionalProperties": false,
      "properties": {
        "abstention_appropriateness": {
          "maximum": 1,
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "cases": {
          "minimum": 0,
          "type": "integer"
        },
        "counterexample_correctness": {
          "maximum": 1,
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "coverage_completeness": {
          "maximum": 1,
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "false_positive_rate": {
          "maximum": 1,
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "invalid_input_rate": {
          "maximum": 1,
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "missed_detection_rate": {
          "maximum": 1,
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "precision": {
          "maximum": 1,
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "recall": {
          "maximum": 1,
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "runtime_ms": {
          "additionalProperties": false,
          "properties": {
            "max": {
              "minimum": 0,
              "type": "number"
            },
            "median": {
              "minimum": 0,
              "type": "number"
            },
            "p95": {
              "minimum": 0,
              "type": "number"
            }
          },
          "required": [
            "median",
            "p95",
            "max"
          ],
          "type": "object"
        },
        "selected_backend_execution_correctness": {
          "maximum": 1,
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "unknown_rate": {
          "maximum": 1,
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "precision",
        "recall",
        "false_positive_rate",
        "missed_detection_rate",
        "unknown_rate",
        "invalid_input_rate",
        "abstention_appropriateness",
        "coverage_completeness",
        "counterexample_correctness",
        "selected_backend_execution_correctness",
        "runtime_ms"
      ],
      "type": "object"
    }
  },
  "$id": "https://openverification.dev/schemas/holdout.aggregate_metrics.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Publishable aggregate metrics only. Must not embed case ids, labels, diffs, or counterexample text.",
  "properties": {
    "benchmark": {
      "const": "FormalPR-Holdout"
    },
    "candidate_source_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "cases_scored": {
      "minimum": 0,
      "type": "integer"
    },
    "disagreement_summary": {
      "additionalProperties": false,
      "properties": {
        "deferred": {
          "minimum": 0,
          "type": "integer"
        },
        "open": {
          "minimum": 0,
          "type": "integer"
        },
        "resolved": {
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "open",
        "resolved",
        "deferred",
        "total"
      ],
      "type": "object"
    },
    "generated_at_unix_ms": {
      "minimum": 0,
      "type": "integer"
    },
    "holdout_asset_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "holdout_release_tag": {
      "type": "string"
    },
    "lanes": {
      "additionalProperties": {
        "$ref": "#/$defs/lane_metrics"
      },
      "minProperties": 1,
      "type": "object"
    },
    "leakage_guard": {
      "additionalProperties": false,
      "properties": {
        "case_ids_emitted": {
          "const": false
        },
        "fail_closed": {
          "type": "boolean"
        },
        "labels_emitted": {
          "const": false
        },
        "sanitizer_version": {
          "type": "string"
        }
      },
      "required": [
        "labels_emitted",
        "case_ids_emitted",
        "fail_closed"
      ],
      "type": "object"
    },
    "ovk_commit_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "predictions_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "reviewer_time": {
      "additionalProperties": false,
      "properties": {
        "median_minutes_added": {
          "type": [
            "number",
            "null"
          ]
        },
        "median_minutes_saved": {
          "type": [
            "number",
            "null"
          ]
        },
        "notes": {
          "description": "Aggregate-only note; no case identifiers.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "schema_version": {
      "const": "formalpr_holdout.aggregate_metrics.v1"
    },
    "verified_source_sha": {
      "pattern": "^[0-9a-f]{7,40}$",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "benchmark",
    "holdout_release_tag",
    "ovk_commit_sha",
    "generated_at_unix_ms",
    "lanes",
    "disagreement_summary",
    "leakage_guard",
    "candidate_source_sha",
    "predictions_sha256",
    "holdout_asset_sha256"
  ],
  "title": "FormalPR-Holdout Aggregate Metrics",
  "type": "object"
}
