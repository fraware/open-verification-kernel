{
  "schema_version": "ovk.support_contract.v1",
  "profile_id": "authorization.fastapi.ast_v1",
  "contract_version": "1.1.0",
  "lane": "authorization",
  "proposition": "Within the bounded Python-AST subset, every extracted FastAPI route records its static path, handler, and dependency identities; admin protection may be asserted only for guard identities whose provenance is supported by the profile.",
  "guarantee_type": "source_grounded_authorization_coverage",
  "compiler_binding": "ovk.compilers.authorization.fastapi_ast:FastApiAstAuthorizationCompiler",
  "supported_constructs": [
    "APIRouter",
    "include_router",
    "Depends",
    "Annotated",
    "Security",
    "static_path_literals",
    "same_module_guard_definitions"
  ],
  "excluded_constructs": [
    "dynamic_path_construction",
    "runtime_dependency_overrides",
    "unknown_auth_wrappers",
    "star_import_unbounded_symbols",
    "cross_module_guard_provenance_until_canonical_symbol_resolution_is_complete",
    "package_reexports_until_canonical_symbol_resolution_is_complete"
  ],
  "required_materials": [
    "python_source_files",
    "base_and_or_head_revisions"
  ],
  "coverage_criteria": {
    "complete_requires": [
      "all_routes_have_fq_identity",
      "no_unsupported_constructs",
      "trusted_guard_provenance_supported_by_profile"
    ],
    "unsupported_forces": "review"
  },
  "language_or_tool_versions": {
    "python": ">=3.11",
    "fastapi": ">=0.100"
  },
  "notes": [
    "Cross-module aliases and reexports are not a strict-supported construct until canonical module/symbol provenance is enforced end-to-end.",
    "Regex FastAPI compilation remains advisory only.",
    "This profile cannot be strict-eligible without candidate-bound executed qualification evidence."
  ]
}
