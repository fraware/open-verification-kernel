{
  "schema_version": "ovk.support_contract.v1",
  "profile_id": "authorization.express.ast_v1",
  "contract_version": "1.2.0",
  "lane": "authorization",
  "proposition": "Within the bounded lexical JavaScript/TypeScript subset, OVK extracts static Express route registrations and ordered local middleware identifiers; unsupported syntax or unresolved middleware provenance forces review.",
  "guarantee_type": "bounded_source_authorization_candidate",
  "compiler_binding": "ovk.compilers.authorization.express_ast:ExpressAstAuthorizationCompiler",
  "supported_constructs": [
    "express.Router",
    "static_app_use_mount_syntax",
    "router.route_chaining",
    "static_path_literals",
    "static_template_literals_without_interpolation",
    "bounded_esm_cjs_import_alias_scanning",
    "ordered_local_middleware_identifier_lists",
    "simple_typescript_parameter_erasure"
  ],
  "excluded_constructs": [
    "dynamic_path_construction",
    "template_literal_interpolation",
    "eval_or_new_function_middleware",
    "unresolved_spread_middleware",
    "array_literal_string_middleware",
    "jsx_decorators_full_typescript",
    "cross_file_module_graph_provenance",
    "mounted_router_path_composition_as_strict_evidence",
    "identifier_name_heuristics_as_strict_guard_provenance"
  ],
  "required_materials": [
    "js_ts_source_files",
    "base_and_or_head_revisions"
  ],
  "coverage_criteria": {
    "complete_requires": [
      "bounded_lexical_parse_success",
      "no_unsupported_constructs",
      "middleware_order_preserved",
      "no_unresolved_cross_file_guard_provenance"
    ],
    "unsupported_forces": "review"
  },
  "language_or_tool_versions": {
    "parser_id": "ovk.estree.subset.v2",
    "parser_implementation": "pure_python_bounded_lexical_scanner",
    "node": "not_required",
    "ecmascript": "bounded_ES2022_like_subset"
  },
  "notes": [
    "The current parser does not construct a general ESTree or a cross-file JavaScript module graph; those semantics are explicitly outside the strict boundary.",
    "Legacy regex Express compilation remains advisory only.",
    "This profile cannot be strict-eligible without candidate-bound executed qualification evidence."
  ]
}
