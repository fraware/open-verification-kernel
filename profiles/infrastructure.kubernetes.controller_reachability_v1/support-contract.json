{
  "schema_version": "ovk.support_contract.v1",
  "profile_id": "infrastructure.kubernetes.controller_reachability_v1",
  "contract_version": "1.1.0",
  "lane": "infrastructure",
  "proposition": "Within the supported object subset, OVK computes namespace-scoped Service-to-controller selector edges and syntactic Ingress/Gateway/HTTPRoute reference edges; unsupported controller publicness, cross-namespace authorization, or network-policy semantics force review.",
  "guarantee_type": "bounded_infrastructure_exposure_candidate",
  "compiler_binding": "ovk.compilers.infrastructure.kubernetes:compile_kubernetes_objects",
  "supported_constructs": [
    "Service",
    "Deployment_StatefulSet_DaemonSet",
    "namespace_scoped_service_selectors",
    "Ingress_reference_extraction",
    "Gateway_reference_extraction",
    "HTTPRoute_reference_extraction",
    "NetworkPolicy_syntax_capture",
    "Role_ClusterRole_bindings_as_separate_graph",
    "Secret_env_volume_refs"
  ],
  "excluded_constructs": [
    "ingress_class_name_as_proof_of_public_reachability",
    "gateway_class_name_as_proof_of_public_reachability",
    "cross_namespace_backend_authorization_until_ReferenceGrant_is_enforced",
    "NetworkPolicy_as_reachability_constraint_until_policy_semantics_are_enforced",
    "arbitrary_CRDs_without_plugin"
  ],
  "required_materials": [
    "kubernetes_objects_list_or_items"
  ],
  "coverage_criteria": {
    "complete_requires": [
      "namespace_scoped_service_edges",
      "no_unsupported_kinds_in_strict_set",
      "no_unresolved_controller_publicness",
      "no_unresolved_cross_namespace_authorization",
      "no_unapplied_network_policy_semantics"
    ],
    "unsupported_forces": "review"
  },
  "language_or_tool_versions": {
    "kubernetes": ">=1.26",
    "gateway_api": ">=0.8"
  },
  "notes": [
    "Current Gateway, Ingress, ReferenceGrant, and NetworkPolicy parsing is useful candidate evidence but not yet a complete network-semantics proof.",
    "CRDs remain unsupported unless a versioned plugin exists.",
    "This profile cannot be strict-eligible without candidate-bound executed qualification evidence."
  ]
}
