{
  "schema_version": "ovk.support_contract.v1",
  "profile_id": "infrastructure.terraform.plan_recursive_v1",
  "contract_version": "1.0.0",
  "lane": "infrastructure",
  "proposition": "Public exposure claims for Terraform resources are derived only from concrete plan fields and bounded provider path profiles; after_unknown/sensitive exposure forces review.",
  "guarantee_type": "bounded_infrastructure_exposure",
  "compiler_binding": "ovk.compilers.infrastructure.terraform_plan:compile_terraform_plan",
  "supported_constructs": [
    "resource_changes",
    "planned_values_recursive_modules",
    "after_unknown",
    "sensitive_values",
    "count_for_each_addresses",
    "aws_azure_gcp_family_paths"
  ],
  "excluded_constructs": [
    "generic_public_true_without_path",
    "untrusted_cloud_credential_plan_generation",
    "missing_provider_lockfile_for_strict"
  ],
  "required_materials": [
    "terraform_show_json_plan",
    "format_version"
  ],
  "coverage_criteria": {
    "complete_requires": [
      "resource_changes_or_recursive_planned_values",
      "no_unknown_exposure_as_private",
      "concrete_provider_path_or_review"
    ],
    "unsupported_forces": "review"
  },
  "language_or_tool_versions": {
    "terraform": ">=1.5",
    "plan_format": "1.2"
  },
  "notes": [
    "Plans must be sandbox-generated or attested; never run untrusted PR Terraform with cloud credentials."
  ]
}
