{
  "schema_version": "ovk.support_contract.v1",
  "profile_id": "ci_secrets.actions.permissions_flow_v1",
  "contract_version": "1.1.0",
  "lane": "ci_secrets",
  "proposition": "Workflow trust findings for secrets, token authority, protected environments, reusable workflows, and privileged OIDC are derived from workflow YAML plus separately trusted acquisition materials within the supported expression subset.",
  "guarantee_type": "workflow_trust_flow_candidate",
  "compiler_binding": "ovk.compilers.github_actions.trust_flow:compile_workflow_trust",
  "supported_constructs": [
    "local_reusable_workflows",
    "remote_reusable_at_sha",
    "composite_local_recursion",
    "finite_matrix_shape_evaluation",
    "job_permissions",
    "secrets_inherit",
    "id_token_write_as_privileged",
    "pr_head_artifact_taint"
  ],
  "excluded_constructs": [
    "mutable_remote_refs",
    "yaml_self_asserted_protected_environment",
    "unbounded_matrix_explosion",
    "matrix_dependent_trust_expressions_until_each_assignment_is_evaluated"
  ],
  "required_materials": [
    "workflow_yaml_or_document",
    "trusted_event_metadata_when_fork_facts_required"
  ],
  "coverage_criteria": {
    "complete_requires": [
      "no_mutable_remote_refs",
      "protected_env_from_acquisition_when_claimed",
      "matrix_finite",
      "no_unresolved_matrix_dependent_trust_expression"
    ],
    "unsupported_forces": "review"
  },
  "language_or_tool_versions": {
    "github_actions": "v3+",
    "workflow_schema": "github-workflow"
  },
  "notes": [
    "Protected environment facts require authenticated acquisition artifacts; YAML cannot self-assert protection.",
    "Finite matrix counting alone is not strict evidence when matrix values alter a trust-relevant expression.",
    "This profile cannot be strict-eligible without candidate-bound executed qualification evidence."
  ]
}
